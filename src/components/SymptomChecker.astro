<!-- SECTION 2: INTERACTIVE 30-SEC SYMPTOM CHECK (2x3 Visual Grid) -->
<section class="sec-block sec-alt">
  <div class="wrap">
    <div class="sec-eyebrow">Interactive 30-Second Self-Check</div>
    <h2 class="sec-title">Tap What You’re Experiencing Right Now</h2>
    <p class="sec-sub">Select any pattern below to see how our structured therapy helps:</p>

    <div class="symptom-grid">
      <div class="sym-tile checked" data-symptom="Intrusive Thoughts">
        <div class="sym-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 2a9 9 0 0 0-9 9c0 3.6 2.4 6.6 5.7 7.6L10 22h4l1.3-3.4C18.6 17.6 21 14.6 21 11a9 9 0 0 0-9-9z"/><path d="M9 10c.5-1.5 2.5-2 4-1s1.5 3 0 4-3.5.5-4-1"/></svg>
        </div>
        <div class="sym-info">
          <div class="sym-name">Intrusive Thoughts</div>
          <div class="sym-desc">Unwanted images, harm fears or endless "what ifs"</div>
        </div>
      </div>

      <div class="sym-tile" data-symptom="Checking & Washing">
        <div class="sym-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
        </div>
        <div class="sym-info">
          <div class="sym-name">Checking / Washing</div>
          <div class="sym-desc">Locks, switches, contamination or purity rituals</div>
        </div>
      </div>

      <div class="sym-tile" data-symptom="Religious OCD (Waswasa)">
        <div class="sym-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </div>
        <div class="sym-info">
          <div class="sym-name">Waswasa / Doubts</div>
          <div class="sym-desc">Wudu, Salah, purity or terrifying faith doubts</div>
        </div>
      </div>

      <div class="sym-tile" data-symptom="Panic & Racing Heart">
        <div class="sym-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div class="sym-info">
          <div class="sym-name">Panic &amp; Dread</div>
          <div class="sym-desc">Racing heart, chest tightness &amp; fear of losing control</div>
        </div>
      </div>

      <div class="sym-tile" data-symptom="Meds Didn't Break Loop">
        <div class="sym-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="8" width="18" height="8" rx="4" transform="rotate(-45 12 12)"/><line x1="9.5" y1="9.5" x2="14.5" y2="14.5"/></svg>
        </div>
        <div class="sym-info">
          <div class="sym-name">Tried Meds / Clinics</div>
          <div class="sym-desc">Temporary calm, but compulsive habit still returns</div>
        </div>
      </div>

      <div class="sym-tile" data-symptom="Couple / Family Conflict">
        <div class="sym-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </div>
        <div class="sym-info">
          <div class="sym-name">Relationship Strain</div>
          <div class="sym-desc">Emotional distance, arguments or trust issues</div>
        </div>
      </div>
    </div>

    <div class="match-meter-box">
      <div class="meter-text" id="meterText">
        <strong>1 pattern selected:</strong> 100% treatable with structured CBT + ICBT loop retraining.
      </div>
      <button type="button" class="meter-pill js-open-checkout">Start Recovery →</button>
    </div>
  </div>
</section>
