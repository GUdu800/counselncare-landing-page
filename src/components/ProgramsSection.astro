      <div class="prog-svg-box">
        <svg viewBox="0 0 80 80" fill="none"><path d="M40 34C40 34 30 27 30 20C30 16 33 14 36 14C38 14 40 16 40 16C40 16 42 14 44 14C47 14 50 16 50 20C50 27 40 34 40 34Z" fill="#FFF1F2" stroke="#6B1D35" stroke-width="2.6"/><circle cx="26" cy="44" r="8" stroke="#0F766E" stroke-width="2.6"/><circle cx="54" cy="44" r="8" stroke="#0F766E" stroke-width="2.6"/><path d="M16 64C16 56 22 52 30 52M64 64C64 56 58 52 50 52" stroke="#0F766E" stroke-width="2.8" stroke-linecap="round"/></svg>
