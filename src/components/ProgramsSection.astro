<!-- SECTION 4: INTERACTIVE 4-PROGRAM TABS + COMPACT SPECIALIST SPOTLIGHT -->
<section class="sec-block sec-alt">
  <div class="wrap">
    <div class="sec-eyebrow">Tailored Recovery Programs</div>
    <h2 class="sec-title">4 Specialized Clinical Tracks</h2>
    <p class="sec-sub">Tap a program below to explore how we treat your specific concern:</p>

    <div class="prog-tabs" role="tablist">
      <button type="button" class="prog-tab active" data-prog="ocd">1. OCD Therapy</button>
      <button type="button" class="prog-tab" data-prog="waswasa">2. Waswasa OCD</button>
      <button type="button" class="prog-tab" data-prog="anxiety">3. Panic/Anxiety</button>
      <button type="button" class="prog-tab" data-prog="couples">4. Couples</button>
    </div>

    <!-- Panel 1: OCD -->
    <div class="prog-panel active" id="prog-ocd">
      <div class="prog-svg-box">
        <svg viewBox="0 0 80 80" fill="none"><path d="M22 66V58C15 57 13 51 14 45L10 40C9 38 10 36 12 35L15 28C17 15 29 9 42 10C55 11 63 22 61 36C60 45 56 52 55 64" stroke="#6B1D35" stroke-width="3" stroke-linecap="round"/><path d="M28 32C24 26 34 19 40 24C46 19 53 28 47 34C53 40 43 47 37 41C31 47 23 39 28 32Z" stroke="#0F766E" stroke-width="2.5"/></svg>
