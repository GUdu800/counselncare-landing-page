---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout
  title="Payment Confirmed | Your 1-on-1 Session Is Booked — Counsel N Care"
  description="Thank you for booking your 1-on-1 session with Aftab Siddiqui at Counsel N Care."
>
  <Header
    pulseText="PAYMENT VERIFIED · 1-ON-1 SESSION CONFIRMED"
    subtitle="Booking Confirmation Receipt"
    isThankYou={true}
  />

  <!-- Thank You Hero & Session Pass Card -->
  <section class="ty-hero">
    <div class="ty-check-wrap">
      <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <span class="ty-badge">✓ PAYMENT SUCCESSFUL</span>
    <h1 class="ty-title">Thank You, <span id="tyName">Valued Client</span>! Your Session Is Confirmed.</h1>
    <p class="ty-sub">
      Your 1-on-1 private consultation with <strong>Aftab Siddiqui</strong> has been scheduled. Below is your official session pass.
    </p>

    <!-- Dynamic Booking Pass Ticket -->
    <div class="ticket-card">
      <div class="ticket-head">
        <span>COUNSEL N CARE · SESSION PASS</span>
        <span id="tyBookingId">#CNC-8492</span>
      </div>
      <div class="ticket-body">
        <div class="ticket-item">
          <span class="ticket-lbl">Specialist</span>
          <span class="ticket-val">Aftab Siddiqui</span>
        </div>
        <div class="ticket-item">
          <span class="ticket-lbl">Preferred Slot</span>
          <span class="ticket-val" id="tySlot">Today · 6:00 PM</span>
        </div>
        <div class="ticket-item" style="grid-column: span 2;">
          <span class="ticket-lbl">Selected Clinical Track</span>
          <span class="ticket-val" id="tyConcern">OCD, Waswasa &amp; Anxiety Recovery</span>
        </div>
        <div class="ticket-item">
          <span class="ticket-lbl">Session Format</span>
          <span class="ticket-val">1-on-1 Private Video (50–60m)</span>
        </div>
        <div class="ticket-item">
          <span class="ticket-lbl">Status</span>
          <span class="ticket-val" style="color:#059669;">● Paid &amp; Confirmed</span>
        </div>
      </div>
      <div class="ticket-foot">
        <span>🔒 100% Confidential Telehealth Session</span>
        <span>Includes PDFs &amp; Audio</span>
      </div>
    </div>

    <!-- Direct TealFeed Live Slot Selector -->
    <div class="ty-teal-card">
      <div class="ty-teal-badge">
        <span class="pulse-dot"></span> LIVE CALENDAR SYNC (counselncare.com)
      </div>
      <h3 style="font-size:14.5px;font-weight:800;color:var(--ink);margin:4px 0 2px;">
        Pick or Confirm Your Live Time Slot
      </h3>
      <p style="font-size:11.5px;color:var(--muted);line-height:1.4;margin-bottom:10px;">
        Click below to select your exact time window directly on Aftab Siddiqui’s official booking calendar:
      </p>
      <a
        id="tyTealFeedBtn"
        href="https://www.bookings.tealfeed.com/members/6a23e373c88ca55ecd261939"
        target="_blank"
        rel="noopener"
        class="cta-btn"
        style="text-decoration:none;margin-top:0;"
      >
        <span>🗓️ Open Live TealFeed Booking Calendar →</span>
      </a>
    </div>

    <div class="action-grid">
      <button type="button" class="outline-btn" onclick="window.print()">
        🖨️ Save / Print Receipt
      </button>
      <a
        id="calLink"
        href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=1-on-1+Therapy+Session+with+Aftab+Siddiqui+(Counsel+N+Care)&details=Private+50-60+minute+online+consultation+session+with+Aftab+Siddiqui."
        target="_blank"
        rel="noopener"
        class="outline-btn"
      >
        📅 Add to Calendar
      </a>
    </div>
  </section>

  <!-- What Happens Next + Interactive Pre-Session Checklist -->
  <section class="sec-block">
    <div class="wrap">
      <div class="sec-eyebrow">Before Your Session Begins</div>
      <h2 class="sec-title">3 Quick Steps for Maximum Clarity</h2>
      <p class="sec-sub">Tap each step below as you complete it:</p>

      <div class="prep-list">
        <div class="prep-item done" onclick="this.classList.toggle('done')">
          <div class="prep-box">✓</div>
          <div class="prep-text">
            <h4>1. Check Your Confirmation &amp; Video Link</h4>
            <p>Your private meeting link and reminder have been queued for your registered number <strong id="tyPhone"></strong>.</p>
          </div>
        </div>

        <div class="prep-item" onclick="this.classList.toggle('done')">
          <div class="prep-box">✓</div>
          <div class="prep-text">
            <h4>2. Note Down Your Top 2–3 Looping Thoughts</h4>
            <p>Don’t worry about explaining everything perfectly — Aftab Sir will guide the assessment step by step.</p>
          </div>
        </div>

        <div class="prep-item" onclick="this.classList.toggle('done')">
          <div class="prep-box">✓</div>
          <div class="prep-text">
            <h4>3. Sit in a Quiet, Private Space for 50 Minutes</h4>
            <p>Keep earphones and a notebook handy so you can jot down your personalized CBT / ICBT action plan.</p>
          </div>
        </div>
      </div>

      <!-- Specialist Reassurance Note -->
      <div class="specialist-compact" style="margin-top:14px;">
        <div class="spec-top">
          <img src="assets/aftab-portrait.jpg" alt="Aftab Siddiqui" class="spec-img" style="width:86px;height:86px;" />
          <div>
            <span class="spec-badge">A Note From Your Counselor</span>
            <h3 class="spec-name" style="font-size:15px;">“Recovery begins the moment you stop fighting alone.”</h3>
            <p style="font-size:11.5px;color:var(--body);margin-top:4px;line-height:1.4;">
              I look forward to speaking with you in our upcoming 1-on-1 session and mapping out your clear path to peace. — <strong>Aftab Siddiqui</strong>
            </p>
          </div>
        </div>
      </div>

      <a href="index.html" class="cta-btn" style="margin-top:14px;text-decoration:none;">
        <span>← Return to Main Page</span>
      </a>
    </div>
  </section>

  <footer class="mini-footer">
    <strong>Counsel N Care · Aftab Siddiqui</strong>
    <p>© 2026 Counsel N Care. All sessions are 100% confidential.</p>
  </footer>

  <style>
    :global(body) {
      padding-bottom: 32px;
    }
    .ty-hero {
      background: radial-gradient(circle at 50% 0%, #d1fae5 0%, #ffffff 75%);
      padding: 24px 15px 18px;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }
    .ty-check-wrap {
      width: 68px;
      height: 68px;
      margin: 0 auto 10px;
      border-radius: 50%;
      background: #10b981;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 0 10px rgba(16, 185, 129, 0.16);
      animation: popScale 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes popScale {
      0% { transform: scale(0.5); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .ty-check-wrap svg {
      width: 34px;
      height: 34px;
      stroke: #fff;
      stroke-width: 3.2;
      fill: none;
    }
    .ty-badge {
      display: inline-block;
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #6ee7b7;
      font-size: 10.5px;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: 999px;
      margin-bottom: 6px;
    }
    .ty-title {
      font-size: 20px;
      font-weight: 800;
      color: var(--ink);
      line-height: 1.22;
      margin-bottom: 5px;
    }
    .ty-sub {
      font-size: 12.2px;
      color: var(--body);
      line-height: 1.45;
    }
    .ticket-card {
      background: #fff;
      border: 1.5px solid var(--teal);
      border-radius: 14px;
      margin-top: 14px;
      overflow: hidden;
      text-align: left;
      box-shadow: 0 8px 20px rgba(15, 118, 110, 0.1);
    }
    .ticket-head {
      background: var(--teal);
      color: #fff;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11.5px;
      font-weight: 800;
    }
    .ticket-body {
      padding: 12px 14px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .ticket-item {
      display: flex;
      flex-direction: column;
    }
    .ticket-lbl {
      font-size: 10px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
    }
    .ticket-val {
      font-size: 12.5px;
      font-weight: 800;
      color: var(--ink);
      margin-top: 1px;
    }
    .ticket-foot {
      background: #f8fafc;
      border-top: 1px dashed #cbd5e1;
      padding: 9px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      font-weight: 700;
      color: var(--teal-dark);
    }
    .prep-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin: 12px 0 14px;
    }
    .prep-item {
      background: #fff;
      border: 1.5px solid var(--border);
      border-radius: 11px;
      padding: 11px 12px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      cursor: pointer;
      user-select: none;
    }
    .prep-item.done {
      border-color: #10b981;
      background: #ecfdf5;
    }
    .prep-box {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      border: 2px solid var(--teal);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
      color: transparent;
      font-weight: 800;
      font-size: 13px;
    }
    .prep-item.done .prep-box {
      background: #10b981;
      border-color: #10b981;
      color: #fff;
    }
    .prep-text h4 {
      font-size: 12.8px;
      font-weight: 800;
      color: var(--ink);
    }
    .prep-text p {
      font-size: 11.2px;
      color: var(--muted);
      line-height: 1.35;
      margin-top: 1px;
    }
    .action-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 10px;
    }
    .ty-teal-card {
      background: #f0fdfa;
      border: 1.5px solid #0d9488;
      border-radius: 13px;
      padding: 12px 14px;
      margin-top: 14px;
      text-align: center;
      box-shadow: 0 4px 14px rgba(13, 148, 136, 0.08);
    }
    .ty-teal-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ccfbf1;
      color: #0f766e;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.04em;
      padding: 3px 8px;
      border-radius: 999px;
      margin-bottom: 4px;
    }
    .outline-btn {
      background: #fff;
      border: 1.5px solid var(--border);
      color: var(--ink);
      font-family: inherit;
      font-size: 12px;
      font-weight: 800;
      padding: 10px;
      border-radius: 10px;
      cursor: pointer;
      text-align: center;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
    }
    .outline-btn:hover {
      border-color: var(--teal);
    }
  </style>

  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var name = params.get('name');
      var phone = params.get('phone');
      var concern = params.get('concern');
      var slot = params.get('slot');
      var bid = params.get('id');
      var tealUrl = params.get('tealUrl');

      if (name) document.getElementById('tyName').textContent = name;
      if (phone) document.getElementById('tyPhone').textContent = '(' + phone + ')';
      if (concern) document.getElementById('tyConcern').textContent = concern;
      if (slot) document.getElementById('tySlot').textContent = slot;
      if (bid) {
        document.getElementById('tyBookingId').textContent = '#' + bid;
      } else {
        document.getElementById('tyBookingId').textContent = '#CNC-' + Math.floor(1000 + Math.random() * 9000);
      }

      var tealFeedUrls = {
        'OCD & Intrusive Thoughts': 'https://tealfeed.com/care_891921/connect/call?callType=6a33e7d7be9e52a1656f9244',
        'Religious OCD (Waswasa / Scrupulosity)': 'https://tealfeed.com/care_891921/connect/package?packageId=6a33e7cf1e9ad26920c0e452',
        'Panic Attacks & Severe Anxiety': 'https://www.tealfeed.com/care_891921/connect/call?callType=6a4ce48f19832a00610cb914',
        'Marriage & Couple Counseling': 'https://tealfeed.com/care_891921/connect/call?callType=6a33e7dc1e9ad26920c0e475'
      };
      var targetTeal = tealUrl || (concern && tealFeedUrls[concern]) || 'https://www.bookings.tealfeed.com/members/6a23e373c88ca55ecd261939';
      var tealBtn = document.getElementById('tyTealFeedBtn');
      if (tealBtn) tealBtn.href = targetTeal;
    })();
    })();
  </script>
</BaseLayout>
